var LABELS = { year: '年K', month: '月K', week: '周K', day: '日K', min30: '30分' };
var MAX = { year: 50, month: 50, week: 50, day: 50, min30: 64 };

function periodLabel(period) {
  return LABELS[period] || '周K';
}

function maxBars(period) {
  return MAX[period] || 50;
}

function cardMaxBars(period) {
  var CARD = { year: 24, month: 24, week: 24, day: 24, min30: 32 };
  return CARD[period] || 24;
}

function displayCode(code) {
  if (!code) return '';
  var c = String(code).toLowerCase();
  if (c.indexOf('sh') === 0) return c.slice(2);
  if (c.indexOf('sz') === 0) return c.slice(2);
  return c;
}

module.exports = {
  periodLabel: periodLabel,
  maxBars: maxBars,
  cardMaxBars: cardMaxBars,
  displayCode: displayCode
};
