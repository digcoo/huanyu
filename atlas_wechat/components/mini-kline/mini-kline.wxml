<view class="mini-kline {{resonance}} size-{{size}} {{flipped ? 'is-flipped' : ''}} {{showMacd ? 'has-macd' : ''}}">
  <view class="label-row" wx:if="{{label || markerLabel || hasMarkerLegend || maLegend || macdLegend || updatedLabel}}">
    <view class="label-left">
      <text class="label" wx:if="{{label}}">{{label}}</text>
      <view class="ma-legend" wx:if="{{maLegend}}">
        <text
          wx:for="{{maLines}}"
          wx:key="key"
          class="ma"
          style="color: {{item.color}};"
        >{{item.label}}</text>
      </view>
      <view class="macd-legend" wx:if="{{macdLegend}}">
        <text class="ma" style="color: #f0b90b;">DIF</text>
        <text class="ma" style="color: #e040fb;">DEA</text>
        <text class="ma" style="color: #848e9c;">MACD</text>
      </view>
    </view>
    <view class="label-right">
      <text wx:if="{{updatedLabel}}" class="updated-label">更新 · {{updatedLabel}}</text>
      <text wx:if="{{markerLabel}}" class="marker-label">★ {{markerLabel}}</text>
      <text
        wx:for="{{markerLegend}}"
        wx:key="type"
        class="marker-label marker-{{item.type}}"
      >★ {{item.label}}</text>
    </view>
  </view>
  <view class="chart-shell">
    <view class="chart-wrap">
      <view class="grid-lines">
        <view class="grid-line" wx:for="{{[0,1,2,3,4]}}" wx:key="*this"></view>
      </view>
      <view class="css-chart" wx:if="{{bars.length}}">
        <view
          wx:for="{{bars}}"
          wx:key="index"
          class="candle-slot {{item.slotClass}}"
          style="left: {{item.left}}%; width: {{item.width}}%;"
        >
          <view
            wx:if="{{item.showUpperWick}}"
            class="wick {{item.dirClass}}"
            style="top: {{item.upperWickTop}}%; height: {{item.upperWickH}}%;"
          ></view>
          <view
            class="body {{item.dirClass}}"
            style="top: {{item.bodyTop}}%; height: {{item.bodyH}}%;"
          ></view>
          <view
            wx:if="{{item.showLowerWick}}"
            class="wick {{item.dirClass}}"
            style="top: {{item.lowerWickTop}}%; height: {{item.lowerWickH}}%;"
          ></view>
        </view>
      </view>
      <view wx:if="{{maSegments.length}}" class="ma-layer">
        <view
          wx:for="{{maSegments}}"
          wx:key="id"
          class="ma-seg"
          style="left: {{item.left}}px; top: {{item.top}}px; width: {{item.width}}px; transform: rotate({{item.angle}}deg); background-color: {{item.color}};"
        ></view>
      </view>
      <view
        wx:if="{{markerLeft}}"
        class="add-marker marker-signal"
        style="left: {{markerLeft}}%;"
      >
        <view class="add-marker-line"></view>
        <view class="add-marker-dot"></view>
      </view>
      <view
        wx:for="{{markerPositions}}"
        wx:key="key"
        class="add-marker marker-{{item.type}}"
        style="left: {{item.left}}%;"
      >
        <view class="add-marker-line"></view>
        <view class="add-marker-dot"></view>
      </view>
    </view>
    <view wx:if="{{showMacd && macdBars.length}}" class="macd-wrap">
      <view class="macd-zero-line" style="top: {{macdZeroPct}}%;"></view>
      <view class="macd-hist">
        <view
          wx:for="{{macdBars}}"
          wx:key="index"
          class="macd-bar {{item.dirClass}}"
          style="left: {{item.left}}%; width: {{item.width}}%; top: {{item.top}}%; height: {{item.height}}%;"
        ></view>
      </view>
      <view wx:if="{{macdSegments.length}}" class="macd-line-layer">
        <view
          wx:for="{{macdSegments}}"
          wx:key="id"
          class="ma-seg"
          style="left: {{item.left}}px; top: {{item.top}}px; width: {{item.width}}px; transform: rotate({{item.angle}}deg); background-color: {{item.color}};"
        ></view>
      </view>
    </view>
  </view>
</view>
