.strategy-nav {
  width: 100%;
  box-sizing: border-box;
}

.family-row,
.tier-row {
  display: flex;
  width: 100%;
  gap: 8rpx;
  box-sizing: border-box;
}

.tier-row {
  margin-top: 8rpx;
}

.family-item,
.tier-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #1e2026;
  border: 1rpx solid #2b2f36;
}

.family-item {
  min-height: 80rpx;
  padding: 8rpx 4rpx;
}

.tier-item {
  min-height: 72rpx;
  padding: 8rpx 4rpx;
}

.family-item.active {
  background: rgba(0, 212, 255, 0.1);
  border-color: rgba(0, 212, 255, 0.45);
  box-shadow: 0 0 16rpx rgba(0, 212, 255, 0.12);
}

.tier-item.active {
  background: rgba(0, 212, 255, 0.08);
  border-color: rgba(0, 212, 255, 0.35);
}

.family-icon {
  font-size: 28rpx;
  line-height: 1.2;
  margin-bottom: 4rpx;
}

.tier-icon {
  font-size: 24rpx;
  line-height: 1.2;
  margin-bottom: 2rpx;
}

.family-name {
  font-size: 22rpx;
  color: #848e9c;
  font-weight: 500;
  text-align: center;
  line-height: 1.3;
}

.tier-name {
  font-size: 20rpx;
  color: #6b7585;
  font-weight: 500;
  text-align: center;
  line-height: 1.3;
}

.family-item.active .family-name {
  color: #00d4ff;
  font-weight: 600;
}

.tier-item.active .tier-name {
  color: #00d4ff;
  font-weight: 600;
}
